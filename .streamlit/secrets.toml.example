# Copie este archivo como .streamlit/secrets.toml (NO lo suba a GitHub)
# o pegue su contenido en Streamlit Cloud > App > Settings > Secrets.
# Todas las claves son opcionales.

# ZENROWS_API_KEY = "su_clave_zenrows"
# SCRAPERAPI_KEY  = "su_clave_scraperapi"
# PROXY_URL       = "http://usuario:password@proxy.ejemplo.com:8080"
# COCHESRADAR_MODE = "auto"   # auto | real | demo
